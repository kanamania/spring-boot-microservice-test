# Application
APP_NAME=flex-sms
SERVER_PORT=8080

POST_REQUEST_SIZE=128MB
FILE_UPLOAD_SIZE=128MB

# Database
DATASOURCE_URL=jdbc:postgresql://localhost:9000/flex_sms
DATASOURCE_USERNAME=developer
DATASOURCE_PASSWORD=developer
DATASOURCE_DRIVER=org.postgresql.Driver

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=developer
RABBITMQ_PASSWORD=developer
RABBITMQ_QUEUE_NAME=flex.messages
RABBITMQ_PAYMENT_QUEUE=flex.payment

# Payment Service
PAYMENT_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_API_KEY=flex_sms_payment_key

# Email (SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=test@gmail.com
SPRING_MAIL_PASSWORD="xxxxxxxxxxx"

# SMS Configuration (Twilio Example)
SMS_PROVIDER=TWILIO
SMS_ACCOUNT_SID=your-account-sid
SMS_AUTH_TOKEN=your-auth-token
SMS_PHONE_NUMBER=+1234567890

# Application Settings
NOTIFICATION_PREFERRED_METHOD=EMAIL  # Options: EMAIL, SMS, or BOTH

# Logging
LOGGING_LEVEL_TZ_CO_FLEX=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_RETRY=DEBUG
