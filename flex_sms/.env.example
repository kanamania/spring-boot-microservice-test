# Application
APP_NAME=flex-sms
SERVER_PORT=8080

POST_REQUEST_SIZE=128MB
FILE_UPLOAD_SIZE=128MB

# Database
DATASOURCE_URL=jdbc:postgresql://postgres:5432/flex_sms
DATASOURCE_USERNAME=developer
DATASOURCE_PASSWORD=developer
DATASOURCE_DRIVER=org.postgresql.Driver

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=developer
RABBITMQ_PASSWORD=developer
RABBITMQ_MESSAGES_QUEUE=flex.messages
RABBITMQ_CUSTOMERS_QUEUE=flex.customers
RABBITMQ_PAYMENTS_QUEUE=flex.payments
RABBITMQ_PAYMENT_STATUS_QUEUE=flex.payments.status

# Payment Service
PAYMENT_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_API_KEY=83c27eb209652dbdd1d8a725f762ee018deea8fd285ed3a2736260b524293522

# Email (SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=test@gmail.com
SPRING_MAIL_PASSWORD="xxxxxxxx"

# SMS Configuration (Twilio Example)
SMS_PROVIDER=TWILIO
SMS_ACCOUNT_SID=your-account-sid
SMS_AUTH_TOKEN=your-auth-token
SMS_PHONE_NUMBER=+1234567890

# Application Settings
NOTIFICATION_PREFERRED_METHOD=EMAIL  # Options: EMAIL, SMS, or BOTH

# Logging
LOGGING_LEVEL_TZ_CO_FLEX=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_RETRY=DEBUG

PAYMENT_SERVICE_URL="http://localhost:8082"
PAYMENT_SERVICE_API_KEY="API-83c27eb209652dbdd1d8a725f762ee018deea8fd285ed3a2736260b524293522"
